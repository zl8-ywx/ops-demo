# 复制为 .env 后按需修改；.env 已在 .gitignore 中，不会入库。
# 注意：本文件仅用于本地开发。部署环境请通过平台的环境变量机制注入同名变量。

# 构建信息（流水线里由 CI 注入，不用手改）
APP_VERSION=1.0.0
GIT_COMMIT=unknown
ENV_NAME=local

# 不配也能跑：默认使用系统临时目录下的 SQLite 文件（ops-demo.db）
# 需要固定位置时取消注释（相对路径会落在 Flask 的 instance/ 目录）：
# DATABASE_URL=sqlite:///ops-demo.db
# MySQL 示例：
# DATABASE_URL=mysql+pymysql://opsdemo:opsdemo123@127.0.0.1:3306/ops_demo?charset=utf8mb4

# 启动时自动建表。生产环境建议关掉，改用 docs/schema.sql 由 DBA 执行
AUTO_CREATE_TABLES=true

# 就绪探针是否检查数据库。关闭后数据库挂掉也不会摘流量，详见 README「设计权衡」
READYZ_CHECK_DB=true

# 故障注入默认错误率，0 表示不注入
ERROR_RATE=0.0

LOG_LEVEL=INFO
JSON_LOGS=true
MAX_SLOW_MS=10000
MAX_CPU_MS=5000
